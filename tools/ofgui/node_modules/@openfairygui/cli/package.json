{
  "name": "@openfairygui/cli",
  "version": "0.7.0",
  "description": "FairyGUI Headless Authoring SDK — command-line interface.",
  "author": "OpenFairyGUI Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
    "directory": "packages/cli"
  },
  "homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
  "bugs": {
    "url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "bin": {
    "ofgui": "bin/cli.cjs",
    "openfairygui": "bin/cli.cjs"
  },
  "files": [
    "dist/",
    "bin/"
  ],
  "keywords": [
    "fairygui",
    "cli",
    "ui",
    "headless",
    "authoring",
    "publish",
    "restore"
  ],
  "dependencies": {
    "commander": "^14.0.2",
    "jiti": "^2.7.0",
    "@openfairygui/backend": "0.7.0",
    "@openfairygui/functions": "0.7.0",
    "@openfairygui/core": "0.7.0"
  },
  "optionalDependencies": {
    "sharp": ">=0.33.0 <0.35.0"
  },
  "scripts": {
    "build": "tsdown src/cli.ts --format esm --platform node --no-dts --external sharp --external jiti"
  }
}