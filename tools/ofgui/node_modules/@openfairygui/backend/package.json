{
  "name": "@openfairygui/backend",
  "version": "0.7.0",
  "description": "FairyGUI Headless Authoring SDK — stateful backend runtime and session services.",
  "author": "OpenFairyGUI Contributors",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/OpenFairyGUI/OpenFairyGUI.git",
    "directory": "packages/backend"
  },
  "homepage": "https://github.com/OpenFairyGUI/OpenFairyGUI#readme",
  "bugs": {
    "url": "https://github.com/OpenFairyGUI/OpenFairyGUI/issues"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.mts",
  "exports": {
    ".": {
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      },
      "default": {
        "types": "./dist/index.d.mts",
        "default": "./dist/index.mjs"
      }
    },
    "./docs": {
      "require": {
        "types": "./dist/docs.d.cts",
        "default": "./dist/docs.cjs"
      },
      "default": {
        "types": "./dist/docs.d.mts",
        "default": "./dist/docs.mjs"
      }
    },
    "./node": {
      "require": {
        "types": "./dist/node.d.cts",
        "default": "./dist/node.cjs"
      },
      "default": {
        "types": "./dist/node.d.mts",
        "default": "./dist/node.mjs"
      }
    }
  },
  "files": [
    "docs/",
    "dist/"
  ],
  "keywords": [
    "fairygui",
    "backend",
    "session",
    "authoring",
    "runtime"
  ],
  "dependencies": {
    "@openfairygui/core": "0.7.0",
    "@openfairygui/functions": "0.7.0"
  },
  "devDependencies": {
    "ava": "^7.0.0",
    "tsx": "^4.0.0",
    "@openfairygui/test-utils": "0.3.0"
  },
  "scripts": {
    "build": "tsdown",
    "build:watch": "tsdown --watch"
  }
}