{
    "compilerOptions": {
        "target": "es2021",
        "module": "nodenext",
        "moduleResolution": "nodenext",
        "lib": ["es2021"],
        "types": ["node"],
        "strict": false,
        "noImplicitAny": false,
        "skipLibCheck": true,
        "noEmit": true
    },
    "include": [
        "types/**/*.d.ts",
        "shared/**/*.ts",
        "*/src/**/*.ts"
    ]
}
